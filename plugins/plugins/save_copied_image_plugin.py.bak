import os
import sys
import subprocess
import tkinter as tk
from tkinter import ttk, messagebox
from PIL import ImageGrab

def register_plugin(plugin_api):
    """
    Adds a "Save Copied Image" button to the Image tab.
    When clicked, it checks for an image in the clipboard, saves it to an
    "output" folder in the app's root directory with a three-digit padded
    filename, and auto-opens that folder.
    """
    # Retrieve the Image tab from the app's plugin_tabs dictionary.
    image_tab = plugin_api.app.plugin_tabs.get("Image")
    if image_tab is None:
        messagebox.showerror("Error", "Image tab not found. Cannot add 'Save Copied Image' button.")
        return

    def save_copied_image():
        try:
            img = ImageGrab.grabclipboard()
            if img is None:
                # Do nothing if no image is in the clipboard.
                return
            # Determine the app's root directory (one level above the plugins folder)
            plugin_dir = os.path.dirname(__file__)
            app_root = os.path.abspath(os.path.join(plugin_dir, ".."))
            output_dir = os.path.join(app_root, "output")
            if not os.path.exists(output_dir):
                os.makedirs(output_dir)
            # Build a unique filename with 3-digit padded numbering.
            base_filename = "clipboard_image"
            ext = ".png"
            save_path = os.path.join(output_dir, f"{base_filename}_001{ext}")
            counter = 1
            while os.path.exists(save_path):
                counter += 1
                save_path = os.path.join(output_dir, f"{base_filename}_{counter:03d}{ext}")
            img.save(save_path)
            open_folder(output_dir)
        except Exception as e:
            messagebox.showerror("Error", f"Failed to save image: {e}")

    def open_folder(folder):
        try:
            if sys.platform.startswith("win"):
                os.startfile(folder)
            elif sys.platform.startswith("darwin"):
                subprocess.run(["open", folder])
            else:
                subprocess.run(["xdg-open", folder])
        except Exception as e:
            messagebox.showerror("Error", f"Failed to open folder: {e}")

    # Create and pack the button in the Image tab.
    button = ttk.Button(image_tab, text="Save Copied Image", command=save_copied_image)
    button.pack(pady=5)
